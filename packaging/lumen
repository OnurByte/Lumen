#!/bin/sh
# lumen: command-line launcher for Lumen.
#
#   lumen                 open the Lumen app
#   lumen rehearse [SHOW] rehearsal room, nothing goes live (--scripted: no AI needed)
#   lumen live [SHOW]     go live: voice and audio, 9:16 frame for OBS, control room
#   lumen shows           list your shows
#   lumen status          show what is running
#   lumen update          install the latest version (--check, --rollback)
#   lumen info            version and folders
#   lumen generate persona|skill|avatar|review|refine [--force]   author shows with codex
#
# SHOW is a name from `lumen shows` or a path to a .toml file.
set -eu

DATA="${LUMEN_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/lumen}"
PACKS="$DATA/packs"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}/lumen"
SOCKET="$RUNTIME/control.sock"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/lumen"

say() { printf '%s\n' "$*"; }
fail() {
    printf 'lumen: %s\n' "$*" >&2
    exit 1
}
have() { command -v "$1" >/dev/null 2>&1; }

have lumend || fail "lumend not found on PATH; run the installer again"

default_show() {
    if [ -n "${LUMEN_PACK:-}" ]; then printf '%s' "$LUMEN_PACK"; return; fi
    for f in "$PACKS"/personas/*.toml; do
        [ -f "$f" ] || continue
        basename "$f" .toml
        return
    done
    fail "you have no shows yet; open Lumen to create one"
}

show_path() {
    case "$1" in
        */* | *.toml) [ -f "$1" ] || fail "show not found: $1"; printf '%s' "$1" ;;
        *) [ -f "$PACKS/personas/$1.toml" ] || fail "unknown show '$1' (see: lumen shows)"
           printf '%s' "$PACKS/personas/$1.toml" ;;
    esac
}

uses_codex() { grep -q '^provider = "codex"' "$1"; }

running() { lumend control "$SOCKET" status >/dev/null 2>&1; }

start_daemon() { # $@ = lumend arguments
    if running; then
        fail "a show is already running ($SOCKET). Stop it first: lumend control $SOCKET stop"
    fi
    mkdir -p "$RUNTIME" "$STATE"
    chmod 700 "$RUNTIME"
    rm -f "$SOCKET"
    lumend "$@" >"$STATE/lumend.log" 2>&1 &
    DAEMON=$!
    trap 'kill "$DAEMON" 2>/dev/null || true; wait "$DAEMON" 2>/dev/null || true' EXIT INT TERM
    i=0
    while ! running; do
        i=$((i + 1))
        kill -0 "$DAEMON" 2>/dev/null || { cat "$STATE/lumend.log" >&2; fail "runtime did not start"; }
        [ "$i" -lt 100 ] || fail "runtime did not answer on $SOCKET"
        sleep 0.1
    done
}

need_codex() {
    have codex || fail "this needs the codex CLI signed in to your ChatGPT account (npm i -g @openai/codex && codex login), or use: lumen rehearse --scripted"
}

command="${1:-app}"
[ $# -gt 0 ] && shift
case "$command" in
    app | studio)
        exec lumen-studio "$SOCKET"
        ;;
    rehearse)
        mode=--models
        show=""
        for arg in "$@"; do
            case "$arg" in
                --scripted) mode="" ;;
                *) show="$arg" ;;
            esac
        done
        file="$(show_path "${show:-$(default_show)}")"
        if [ -n "$mode" ] && uses_codex "$file"; then need_codex; fi
        # shellcheck disable=SC2086
        start_daemon rehearse "$file" $mode --socket "$SOCKET" --journal "$STATE/rehearsal.sqlite"
        lumen-studio --rehearsal "$SOCKET"
        ;;
    live)
        file="$(show_path "${1:-$(default_show)}")"
        if uses_codex "$file"; then need_codex; fi
        start_daemon serve "$SOCKET" "$STATE/journal.sqlite" "$file"
        lumen-studio --stage "$SOCKET" &
        FRAME=$!
        lumen-studio "$SOCKET"
        kill "$FRAME" 2>/dev/null || true
        ;;
    shows)
        for f in "$PACKS"/personas/*.toml; do
            [ -f "$f" ] || continue
            printf '%-24s %s\n' "$(basename "$f" .toml)" "$(lumend validate-pack "$f" 2>&1)"
        done
        ;;
    status)
        exec lumend control "$SOCKET" status
        ;;
    update | info)
        exec lumen-live "$command" "$@"
        ;;
    generate)
        need_codex
        what="${1:-}"
        [ $# -gt 0 ] && shift
        case "$what" in
            persona) exec lumend generate-pack "$PACKS/briefs" "$PACKS/personas" "$@" ;;
            skill) exec lumend generate-skills "$PACKS/personas" "$@" ;;
            avatar) exec lumend generate-avatars "$PACKS/avatars" "$@" ;;
            review) exec lumend review-personas "$PACKS/personas" "$@" ;;
            refine) exec lumend refine-personas "$PACKS/personas" "$@" ;;
            *) fail "usage: lumen generate persona|skill|avatar|review|refine [--force]" ;;
        esac
        ;;
    -h | --help | help)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        fail "unknown command '$command' (lumen help)"
        ;;
esac
